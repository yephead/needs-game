# Optional: point the browser at a deployed render endpoint.
# Defaults to "/api/ghibli" (the bundled serverless function).
VITE_GHIBLI_API_URL=

# Server-side secrets for the hi-fi cloud render (set ONE).
# fal.ai (recommended, fast img2img):
FAL_KEY=
# Optional override of the fal model id:
# FAL_MODEL=fal-ai/flux/dev/image-to-image

# ...or Replicate:
REPLICATE_API_TOKEN=
# REPLICATE_VERSION=owner/model:versionhash
